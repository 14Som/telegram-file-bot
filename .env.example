# API token from @BotFather (required)
BOT_TOKEN=123456789:AA-placeholder-token-from-botfather

# Your numeric Telegram user ID from @userinfobot (required)
OWNER_ID=123456789

# Optional: private channel for the vault backup. Create a channel, add the
# bot as an admin with post rights, then set its -100... ID here.
# VAULT_CHAT_ID=-1001234567890

# Where the SQLite index is stored (default: data)
DATA_DIR=data
